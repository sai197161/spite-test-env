<?xml version="1.0" ?>
<!--
  Scenario: perpendicular_hallways

  Two 2 m wide hallways crossing at the origin (a "+" intersection).
    - Robot hallway runs along X. Robot spawns at (-4.5, 0) facing +X, goal is (4.5, 0).
    - Actor hallway runs along Y. A walking actor paces back and forth through the intersection.
  The corner walls hide the actor from the robot's lidar/camera until it is close to the
  intersection, so the robot has to detect it late and replan.

  Timing: robot at burger max speed (0.22 m/s) reaches the intersection zone (|x| < 1 m) after
  ~16 s and clears it after ~25 s. The actor crosses y = 0 every ~9.5 s (t = 4.5, 14, 23.5, ...),
  so it is in the intersection while the robot is, regardless of small start-time differences.
  To retime: change the waypoint <time>s below (actor speed = 9 m / walk duration).

  Run:
    ros2 launch /spitesim_ws/src/launch/sim.launch.py \
      world:=/spitesim_ws/src/worlds/perpendicular_hallways.sdf x_pos:=-4.5 y_pos:=0.0 yaw:=0.0
-->
<sdf version="1.8">
  <world name="perpendicular_hallways">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Walls: 0.1 m thick, 1.0 m tall. Hallway inner width 2.0 m (|y| < 1 for the robot hallway,
      |x| < 1 for the actor hallway), inner length ~10 m. Four L-shaped corners + four end caps.
    -->
    <model name="hallways">
      <static>true</static>
      <link name="walls">

        <!-- robot hallway (along X), corner walls -->
        <collision name="wall_px_py_c"><pose>3.05 1.05 0.5 0 0 0</pose><geometry><box><size>4.1 0.1 1.0</size></box></geometry></collision>
        <visual name="wall_px_py_v"><pose>3.05 1.05 0.5 0 0 0</pose><geometry><box><size>4.1 0.1 1.0</size></box></geometry><material><ambient>0.45 0.5 0.6 1</ambient><diffuse>0.45 0.5 0.6 1</diffuse></material></visual>

        <collision name="wall_px_ny_c"><pose>3.05 -1.05 0.5 0 0 0</pose><geometry><box><size>4.1 0.1 1.0</size></box></geometry></collision>
        <visual name="wall_px_ny_v"><pose>3.05 -1.05 0.5 0 0 0</pose><geometry><box><size>4.1 0.1 1.0</size></box></geometry><material><ambient>0.45 0.5 0.6 1</ambient><diffuse>0.45 0.5 0.6 1</diffuse></material></visual>

        <collision name="wall_nx_py_c"><pose>-3.05 1.05 0.5 0 0 0</pose><geometry><box><size>4.1 0.1 1.0</size></box></geometry></collision>
        <visual name="wall_nx_py_v"><pose>-3.05 1.05 0.5 0 0 0</pose><geometry><box><size>4.1 0.1 1.0</size></box></geometry><material><ambient>0.45 0.5 0.6 1</ambient><diffuse>0.45 0.5 0.6 1</diffuse></material></visual>

        <collision name="wall_nx_ny_c"><pose>-3.05 -1.05 0.5 0 0 0</pose><geometry><box><size>4.1 0.1 1.0</size></box></geometry></collision>
        <visual name="wall_nx_ny_v"><pose>-3.05 -1.05 0.5 0 0 0</pose><geometry><box><size>4.1 0.1 1.0</size></box></geometry><material><ambient>0.45 0.5 0.6 1</ambient><diffuse>0.45 0.5 0.6 1</diffuse></material></visual>

        <!-- actor hallway (along Y), corner walls -->
        <collision name="wall_py_px_c"><pose>1.05 3.05 0.5 0 0 0</pose><geometry><box><size>0.1 4.1 1.0</size></box></geometry></collision>
        <visual name="wall_py_px_v"><pose>1.05 3.05 0.5 0 0 0</pose><geometry><box><size>0.1 4.1 1.0</size></box></geometry><material><ambient>0.6 0.5 0.45 1</ambient><diffuse>0.6 0.5 0.45 1</diffuse></material></visual>

        <collision name="wall_py_nx_c"><pose>-1.05 3.05 0.5 0 0 0</pose><geometry><box><size>0.1 4.1 1.0</size></box></geometry></collision>
        <visual name="wall_py_nx_v"><pose>-1.05 3.05 0.5 0 0 0</pose><geometry><box><size>0.1 4.1 1.0</size></box></geometry><material><ambient>0.6 0.5 0.45 1</ambient><diffuse>0.6 0.5 0.45 1</diffuse></material></visual>

        <collision name="wall_ny_px_c"><pose>1.05 -3.05 0.5 0 0 0</pose><geometry><box><size>0.1 4.1 1.0</size></box></geometry></collision>
        <visual name="wall_ny_px_v"><pose>1.05 -3.05 0.5 0 0 0</pose><geometry><box><size>0.1 4.1 1.0</size></box></geometry><material><ambient>0.6 0.5 0.45 1</ambient><diffuse>0.6 0.5 0.45 1</diffuse></material></visual>

        <collision name="wall_ny_nx_c"><pose>-1.05 -3.05 0.5 0 0 0</pose><geometry><box><size>0.1 4.1 1.0</size></box></geometry></collision>
        <visual name="wall_ny_nx_v"><pose>-1.05 -3.05 0.5 0 0 0</pose><geometry><box><size>0.1 4.1 1.0</size></box></geometry><material><ambient>0.6 0.5 0.45 1</ambient><diffuse>0.6 0.5 0.45 1</diffuse></material></visual>

        <!-- end caps -->
        <collision name="cap_px_c"><pose>5.15 0 0.5 0 0 0</pose><geometry><box><size>0.1 2.2 1.0</size></box></geometry></collision>
        <visual name="cap_px_v"><pose>5.15 0 0.5 0 0 0</pose><geometry><box><size>0.1 2.2 1.0</size></box></geometry><material><ambient>0.45 0.5 0.6 1</ambient><diffuse>0.45 0.5 0.6 1</diffuse></material></visual>

        <collision name="cap_nx_c"><pose>-5.15 0 0.5 0 0 0</pose><geometry><box><size>0.1 2.2 1.0</size></box></geometry></collision>
        <visual name="cap_nx_v"><pose>-5.15 0 0.5 0 0 0</pose><geometry><box><size>0.1 2.2 1.0</size></box></geometry><material><ambient>0.45 0.5 0.6 1</ambient><diffuse>0.45 0.5 0.6 1</diffuse></material></visual>

        <collision name="cap_py_c"><pose>0 5.15 0.5 0 0 0</pose><geometry><box><size>2.2 0.1 1.0</size></box></geometry></collision>
        <visual name="cap_py_v"><pose>0 5.15 0.5 0 0 0</pose><geometry><box><size>2.2 0.1 1.0</size></box></geometry><material><ambient>0.6 0.5 0.45 1</ambient><diffuse>0.6 0.5 0.45 1</diffuse></material></visual>

        <collision name="cap_ny_c"><pose>0 -5.15 0.5 0 0 0</pose><geometry><box><size>2.2 0.1 1.0</size></box></geometry></collision>
        <visual name="cap_ny_v"><pose>0 -5.15 0.5 0 0 0</pose><geometry><box><size>2.2 0.1 1.0</size></box></geometry><material><ambient>0.6 0.5 0.45 1</ambient><diffuse>0.6 0.5 0.45 1</diffuse></material></visual>

      </link>
    </model>

    <!--
      Walking actor, paces the Y hallway through the intersection at 1.0 m/s.
      Actors are animated, not physical: they have NO collision with the robot. Lidar and cameras
      do see them. Score "collisions" from poses (robot vs actor distance), not contacts.
      The mesh is downloaded from Gazebo Fuel on first use (needs internet; cached in ~/.gz/fuel).
    -->
    <actor name="crossing_actor">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <!-- walk +Y: -4.5 -> 4.5 in 9 s -->
          <waypoint><time>0.0</time><pose>0 -4.5 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>9.0</time><pose>0 4.5 1.0 0 0 1.5708</pose></waypoint>
          <!-- turn around -->
          <waypoint><time>9.5</time><pose>0 4.5 1.0 0 0 -1.5708</pose></waypoint>
          <!-- walk -Y: 4.5 -> -4.5 in 9 s -->
          <waypoint><time>18.5</time><pose>0 -4.5 1.0 0 0 -1.5708</pose></waypoint>
          <!-- turn around, then the loop restarts -->
          <waypoint><time>19.0</time><pose>0 -4.5 1.0 0 0 1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!--
      Overhead demo camera for recording videos (not part of the robot's perception).
      Looks straight down at the intersection from 9 m; 1.2 rad FOV covers ~12 x 12 m.
      gz topic: demo_cam/image (bridged to ROS as /demo_cam/image).
    -->
    <model name="demo_camera">
      <static>true</static>
      <pose>0 0 9 0 1.5708 0</pose>
      <link name="link">
        <sensor name="demo_cam" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>demo_cam/image</topic>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image>
              <width>720</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>20</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
